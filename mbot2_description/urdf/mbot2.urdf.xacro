<?xml version="1.0"?>
<robot name="mbot2" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- ============================================================ -->
  <!-- Dimensions are approximate, based on mBot2's published        -->
  <!-- overall size (~170 x 95 x 75 mm). Built from primitives only  -->
  <!-- (no mesh files needed).                                       -->
  <!-- ============================================================ -->

  <!-- Chassis -->
  <xacro:property name="chassis_length" value="0.130"/>
  <xacro:property name="chassis_width"  value="0.095"/>
  <xacro:property name="chassis_height" value="0.030"/>
  <xacro:property name="chassis_mass"   value="0.35"/>

  <!-- Drive wheels -->
  <xacro:property name="wheel_radius" value="0.021"/>
  <xacro:property name="wheel_width"  value="0.012"/>
  <xacro:property name="wheel_mass"   value="0.03"/>
  <xacro:property name="wheel_separation" value="0.110"/>
  <xacro:property name="wheel_x" value="-0.015"/>

  <!-- Caster (rear/front support wheel, modeled as a low-friction sphere) -->
  <xacro:property name="caster_radius" value="${wheel_radius}"/>
  <xacro:property name="caster_mass"   value="0.01"/>
  <xacro:property name="caster_x" value="${chassis_length/2 - 0.02}"/>

  <!-- CyberPi controller block on top -->
  <xacro:property name="cyberpi_length" value="0.050"/>
  <xacro:property name="cyberpi_width"  value="0.045"/>
  <xacro:property name="cyberpi_height" value="0.045"/>
  <xacro:property name="cyberpi_mass"   value="0.05"/>
  <xacro:property name="cyberpi_x" value="-0.030"/>

  <!-- Ultrasonic sensor block at the front -->
  <xacro:property name="us_length" value="0.015"/>
  <xacro:property name="us_width"  value="0.045"/>
  <xacro:property name="us_height" value="0.020"/>
  <xacro:property name="us_mass"   value="0.01"/>

  <!-- Quad RGB color sensor array, underside of the chassis -->
  <xacro:property name="qrgb_size" value="0.008"/>
  <xacro:property name="qrgb_height" value="0.004"/>
  <xacro:property name="qrgb_mass"   value="0.001"/>
  <xacro:property name="qrgb_x" value="0.0"/>
  <xacro:property name="qrgb_z" value="${wheel_radius - qrgb_height/2}"/>

  <!-- Colors -->
  <material name="mbot_blue">
    <color rgba="0.05 0.35 0.75 1.0"/>
  </material>
  <material name="mbot_black">
    <color rgba="0.08 0.08 0.08 1.0"/>
  </material>
  <material name="mbot_dark_grey">
    <color rgba="0.25 0.25 0.25 1.0"/>
  </material>
  <material name="mbot_screen">
    <color rgba="0.15 0.75 0.85 1.0"/>
  </material>
  <material name="mbot_eye">
    <color rgba="0.6 0.6 0.6 1.0"/>
  </material>

  <!-- ============================================================ -->
  <!-- base_link : chassis                                           -->
  <!-- Origin is on the ground, centered between the two drive       -->
  <!-- wheels (REP-103: x forward, y left, z up).                    -->
  <!-- ============================================================ -->
  <link name="base_link">
    <visual>
      <origin xyz="0 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
      <material name="mbot_blue"/>
    </visual>
    <collision>
      <origin xyz="0 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
      <geometry>
        <box size="${chassis_length} ${chassis_width} ${chassis_height}"/>
      </geometry>
    </collision>
    <inertial>
      <origin xyz="0 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
      <mass value="${chassis_mass}"/>
      <inertia ixx="0.0006" ixy="0" ixz="0" iyy="0.0009" iyz="0" izz="0.0012"/>
    </inertial>
  </link>

  <!-- ============================================================ -->
  <!-- CyberPi controller block (top, toward the rear)                -->
  <!-- ============================================================ -->
  <link name="cyberpi_link">
    <visual>
      <geometry>
        <box size="${cyberpi_length} ${cyberpi_width} ${cyberpi_height}"/>
      </geometry>
      <material name="mbot_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${cyberpi_length} ${cyberpi_width} ${cyberpi_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${cyberpi_mass}"/>
      <inertia ixx="0.00002" ixy="0" ixz="0" iyy="0.00002" iyz="0" izz="0.00002"/>
    </inertial>
  </link>

  <joint name="cyberpi_joint" type="fixed">
    <parent link="base_link"/>
    <child link="cyberpi_link"/>
    <origin xyz="${cyberpi_x} 0 ${wheel_radius + chassis_height + cyberpi_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Little screen face on the CyberPi block, facing forward/up -->
  <link name="cyberpi_screen_link">
    <visual>
      <geometry>
        <box size="0.004 0.030 0.026"/>
      </geometry>
      <material name="mbot_screen"/>
    </visual>
  </link>

  <joint name="cyberpi_screen_joint" type="fixed">
    <parent link="cyberpi_link"/>
    <child link="cyberpi_screen_link"/>
    <origin xyz="${cyberpi_length/2 - 0.001} 0 0.004" rpy="0 0 0"/>
  </joint>

  <!-- ============================================================ -->
  <!-- Ultrasonic sensor block, front of the chassis                  -->
  <!-- ============================================================ -->
  <link name="ultrasonic_link">
    <visual>
      <geometry>
        <box size="${us_length} ${us_width} ${us_height}"/>
      </geometry>
      <material name="mbot_black"/>
    </visual>
    <collision>
      <geometry>
        <box size="${us_length} ${us_width} ${us_height}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${us_mass}"/>
      <inertia ixx="0.000005" ixy="0" ixz="0" iyy="0.000005" iyz="0" izz="0.000005"/>
    </inertial>
  </link>

  <joint name="ultrasonic_joint" type="fixed">
    <parent link="base_link"/>
    <child link="ultrasonic_link"/>
    <origin xyz="${chassis_length/2 + us_length/2 - 0.003} 0 ${wheel_radius + chassis_height/2}" rpy="0 0 0"/>
  </joint>

  <!-- Two small "eyes" on the ultrasonic sensor, purely cosmetic -->
  <xacro:macro name="us_eye" params="suffix y_off">
    <link name="ultrasonic_eye_${suffix}">
      <visual>
        <geometry>
          <cylinder radius="0.006" length="0.006"/>
        </geometry>
        <material name="mbot_eye"/>
      </visual>
    </link>
    <joint name="ultrasonic_eye_${suffix}_joint" type="fixed">
      <parent link="ultrasonic_link"/>
      <child link="ultrasonic_eye_${suffix}"/>
      <origin xyz="0.009 ${y_off} 0" rpy="0 ${pi/2} 0"/>
    </joint>
  </xacro:macro>
  <xacro:us_eye suffix="left"  y_off="0.012"/>
  <xacro:us_eye suffix="right" y_off="-0.012"/>

  <!-- ============================================================ -->
  <!-- Drive wheels                                                   -->
  <!-- ============================================================ -->
  <xacro:macro name="drive_wheel" params="prefix reflect">
    <link name="${prefix}_wheel_link">
      <visual>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
        <material name="mbot_black"/>
      </visual>
      <collision>
        <origin xyz="0 0 0" rpy="${pi/2} 0 0"/>
        <geometry>
          <cylinder radius="${wheel_radius}" length="${wheel_width}"/>
        </geometry>
      </collision>
      <inertial>
        <mass value="${wheel_mass}"/>
        <inertia ixx="0.00001" ixy="0" ixz="0" iyy="0.00001" iyz="0" izz="0.00001"/>
      </inertial>
    </link>

    <joint name="${prefix}_wheel_joint" type="continuous">
      <parent link="base_link"/>
      <child link="${prefix}_wheel_link"/>
      <origin xyz="${wheel_x} ${reflect * wheel_separation/2} ${wheel_radius}" rpy="0 0 0"/>
      <axis xyz="0 1 0"/>
    </joint>

    <gazebo reference="${prefix}_wheel_link">
      <mu1>1.0</mu1>
      <mu2>1.0</mu2>
    </gazebo>
  </xacro:macro>

  <xacro:drive_wheel prefix="left"  reflect="1"/>
  <xacro:drive_wheel prefix="right" reflect="-1"/>

  <!-- ============================================================ -->
  <!-- Caster (support) wheel, modeled as a low-friction sphere       -->
  <!-- ============================================================ -->
  <link name="caster_link">
    <visual>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
      <material name="mbot_dark_grey"/>
    </visual>
    <collision>
      <geometry>
        <sphere radius="${caster_radius}"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="${caster_mass}"/>
      <inertia ixx="0.000002" ixy="0" ixz="0" iyy="0.000002" iyz="0" izz="0.000002"/>
    </inertial>
  </link>

  <joint name="caster_joint" type="fixed">
    <parent link="base_link"/>
    <child link="caster_link"/>
    <origin xyz="${caster_x} 0 ${caster_radius}" rpy="0 0 0"/>
  </joint>

  <gazebo reference="caster_link">
    <mu1>0.001</mu1>
    <mu2>0.001</mu2>
  </gazebo>

  <!-- ============================================================ -->
  <!-- Quad RGB color sensor array (4x), underside of the chassis    -->
  <!-- Each unit is modeled as a 1x1 pixel downward-facing camera,   -->
  <!-- matching the real Quad RGB module's per-channel color read.   -->
  <!-- ============================================================ -->
  <xacro:macro name="quad_rgb_unit" params="idx y_off">
    <link name="quad_rgb_${idx}_link">
      <visual>
        <geometry>
          <box size="${qrgb_size} ${qrgb_size} ${qrgb_height}"/>
        </geometry>
        <material name="mbot_black"/>
      </visual>
      <inertial>
        <mass value="${qrgb_mass}"/>
        <inertia ixx="1e-8" ixy="0" ixz="0" iyy="1e-8" iyz="0" izz="1e-8"/>
      </inertial>
    </link>

    <joint name="quad_rgb_${idx}_joint" type="fixed">
      <parent link="base_link"/>
      <child link="quad_rgb_${idx}_link"/>
      <origin xyz="${qrgb_x} ${y_off} ${qrgb_z}" rpy="0 0 0"/>
    </joint>

    <gazebo reference="quad_rgb_${idx}_link">
      <sensor name="quad_rgb_${idx}_sensor" type="camera">
        <!-- pitch +90deg: rotates the sensor's forward (+x) axis to point straight down (-z) -->
        <pose>0 0 0 0 1.5707963 0</pose>
        <topic>quad_rgb/${idx}/image</topic>
        <update_rate>15</update_rate>
        <always_on>true</always_on>
        <visualize>false</visualize>
        <camera>
          <horizontal_fov>0.5</horizontal_fov>
          <image>
            <width>1</width>
            <height>1</height>
            <format>R8G8B8</format>
          </image>
          <clip>
            <!-- far must be >= 0.1 (Gazebo Fortress camera clip minimum) -->
            <near>0.01</near>
            <far>0.15</far>
          </clip>
        </camera>
      </sensor>
    </gazebo>
  </xacro:macro>

  <xacro:quad_rgb_unit idx="1" y_off="0.030"/>
  <xacro:quad_rgb_unit idx="2" y_off="0.010"/>
  <xacro:quad_rgb_unit idx="3" y_off="-0.010"/>
  <xacro:quad_rgb_unit idx="4" y_off="-0.030"/>

  <!-- ============================================================ -->
  <!-- Ultrasonic distance sensor (functional)                       -->
  <!-- Modeled after mBot2's real Ultrasonic Sensor 2: output range   -->
  <!-- 5-300 cm, detection angle < 30 deg. Implemented as a single-   -->
  <!-- ray gpu_lidar, which is the standard way to emulate a sonar    -->
  <!-- in Gazebo Sim.                                                 -->
  <!-- ============================================================ -->
  <gazebo reference="ultrasonic_link">
    <sensor name="ultrasonic_sensor" type="gpu_lidar">
      <pose>${us_length/2} 0 0 0 0 0</pose>
      <topic>ultrasonic/scan</topic>
      <update_rate>10</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
      <lidar>
        <scan>
          <horizontal>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>-0.13</min_angle>
            <max_angle>0.13</max_angle>
          </horizontal>
          <vertical>
            <samples>1</samples>
            <resolution>1</resolution>
            <min_angle>0</min_angle>
            <max_angle>0</max_angle>
          </vertical>
        </scan>
        <range>
          <min>0.05</min>
          <max>3.0</max>
          <resolution>0.01</resolution>
        </range>
      </lidar>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- IMU (functional) - CyberPi's built-in gyroscope/accelerometer  -->
  <!-- ============================================================ -->
  <gazebo reference="cyberpi_link">
    <sensor name="imu_sensor" type="imu">
      <topic>imu</topic>
      <update_rate>50</update_rate>
      <always_on>true</always_on>
      <visualize>false</visualize>
    </sensor>
  </gazebo>

  <!-- ============================================================ -->
  <!-- Gazebo Sim plugins (Fortress / gz-sim 6.x, ROS 2 Humble)       -->
  <!-- ============================================================ -->
  <gazebo>
    <plugin filename="libignition-gazebo-diff-drive-system.so"
            name="ignition::gazebo::systems::DiffDrive">
      <left_joint>left_wheel_joint</left_joint>
      <right_joint>right_wheel_joint</right_joint>
      <wheel_separation>${wheel_separation}</wheel_separation>
      <wheel_radius>${wheel_radius}</wheel_radius>
      <max_linear_acceleration>2.0</max_linear_acceleration>
      <topic>cmd_vel</topic>
      <odom_topic>odom</odom_topic>
      <tf_topic>tf</tf_topic>
      <frame_id>odom</frame_id>
      <child_frame_id>base_link</child_frame_id>
      <odom_publish_frequency>30</odom_publish_frequency>
    </plugin>

    <plugin filename="libignition-gazebo-joint-state-publisher-system.so"
            name="ignition::gazebo::systems::JointStatePublisher">
      <topic>joint_states</topic>
    </plugin>
  </gazebo>

</robot>
