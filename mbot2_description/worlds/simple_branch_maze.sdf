<?xml version="1.0"?>
<sdf version="1.6">
  <!--
    Small line-following maze for mbot1/mbot2.
    Start: (-5.4, 0), heading east. The line also covers mbot2 / mbot3 spawns.
    Yellow warning strips on each approach slow the robot before J1/J2/J3.
    The small yellow centre covers the inner RGB sensors while leaving the
    outer RGB sensors on the black side arms.

    Route graph (metres):
      START (-5.4,0) to J1 (-2,0) to blocked end (0.4,0)
                           |
                           J2 (-2,3) to J3 (2,3) to blocked end (4.4,3)
                           |              |
                       blocked end      GOAL (2,5.2)
                         (-2,4.95)

    The maze_solver stops on a yellow marker plus an outer black sensor,
    remembers each junction using odometry, and takes an open side branch.
    At a wall it reverses briefly,
    turns around, follows the line back, and takes the side branch. It
    publishes local digital trail events; a shared multi-robot map is future work.
  -->
  <world name="simple_branch_maze">
    <physics name="1ms" type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_factor>1.0</real_time_factor>
    </physics>

    <plugin filename="libignition-gazebo-physics-system.so"
            name="ignition::gazebo::systems::Physics"/>
    <plugin filename="libignition-gazebo-user-commands-system.so"
            name="ignition::gazebo::systems::UserCommands"/>
    <plugin filename="libignition-gazebo-scene-broadcaster-system.so"
            name="ignition::gazebo::systems::SceneBroadcaster"/>
    <plugin filename="libignition-gazebo-sensors-system.so"
            name="ignition::gazebo::systems::Sensors">
      <render_engine>ogre2</render_engine>
    </plugin>

    <light type="directional" name="sun">
      <cast_shadows>false</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>1 1 1 1</diffuse>
      <specular>0.3 0.3 0.3 1</specular>
      <direction>-0.4 0.2 -0.9</direction>
    </light>

    <model name="white_floor">
      <static>true</static>
      <link name="floor">
        <collision name="floor_collision">
          <geometry><plane><normal>0 0 1</normal><size>18 12</size></plane></geometry>
        </collision>
        <visual name="floor_visual">
          <geometry><plane><normal>0 0 1</normal><size>18 12</size></plane></geometry>
          <material><ambient>0.9 0.9 0.9 1</ambient><diffuse>0.9 0.9 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Flat visual-only strips. The central black line is 5 cm wide.
         Raised colour markers and shadow-free lighting avoid depth/shadow
         artifacts in Gazebo's 1-pixel RGB sensor views. -->
    <model name="line_and_markers">
      <static>true</static>
      <link name="paint">
        <!-- START to J1, including the first junction. -->
        <visual name="start_to_j1">
          <pose>-5.1 0 0.001 0 0 0</pose>
          <geometry><box><size>6.2 0.05 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>
        <!-- J1: straight leads to a wall; north leads to J2. -->
        <visual name="j1_straight_blocked">
          <pose>-0.9 0 0.001 0 0 0</pose>
          <geometry><box><size>2.2 0.05 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>
        <visual name="j1_north_to_j2">
          <pose>-2 1.5 0.001 0 0 0</pose>
          <geometry><box><size>0.05 3.0 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>
        <!-- J2: north leads to a wall; east leads to J3. -->
        <visual name="j2_north_blocked">
          <pose>-2 3.85 0.001 0 0 0</pose>
          <geometry><box><size>0.05 1.7 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>
        <visual name="j2_east_to_j3">
          <pose>0 3 0.001 0 0 0</pose>
          <geometry><box><size>4.0 0.05 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>
        <!-- J3: straight leads to a wall; north leads to the green goal. -->
        <visual name="j3_east_blocked">
          <pose>3.1 3 0.001 0 0 0</pose>
          <geometry><box><size>2.2 0.05 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>
        <visual name="j3_north_to_goal">
          <pose>2 4.1 0.001 0 0 0</pose>
          <geometry><box><size>0.05 2.2 0.001</size></box></geometry>
          <material><ambient>0.005 0.005 0.005 1</ambient><diffuse>0.005 0.005 0.005 1</diffuse></material>
        </visual>

        <!-- Yellow warning strips run 5-25 cm before each centre. Each strip
             is 3 cm wide, so the 3 cm outer RGB sensors can still see a
             black side branch at the 4 cm centre marker. Keep a 2.5 cm gap
             from the centre so perpendicular strips do not cover that view. -->
        <visual name="j1_warning_west">
          <pose>-2.15 0 0.0035 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j1_warning_east">
          <pose>-1.85 0 0.0035 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j1_warning_north">
          <pose>-2 0.15 0.0035 0 0 0</pose>
          <geometry><box><size>0.03 0.20 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j2_warning_south">
          <pose>-2 2.85 0.0035 0 0 0</pose>
          <geometry><box><size>0.03 0.20 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j2_warning_north">
          <pose>-2 3.15 0.0035 0 0 0</pose>
          <geometry><box><size>0.03 0.20 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j2_warning_east">
          <pose>-1.85 3 0.0035 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j3_warning_west">
          <pose>1.85 3 0.0035 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j3_warning_east">
          <pose>2.15 3 0.0035 0 0 0</pose>
          <geometry><box><size>0.20 0.03 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j3_warning_north">
          <pose>2 3.15 0.0035 0 0 0</pose>
          <geometry><box><size>0.03 0.20 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>

        <!-- Only the 4 cm centre covers the inner sensors (at +/-1 cm).
             Outer sensors (+/-3 cm) still see the black side branches. -->
        <visual name="j1_junction_yellow">
          <pose>-2 0 0.0035 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j2_junction_yellow">
          <pose>-2 3 0.0035 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="j3_junction_yellow">
          <pose>2 3 0.0035 0 0 0</pose>
          <geometry><box><size>0.04 0.04 0.001</size></box></geometry>
          <material><ambient>1 0.75 0 1</ambient><diffuse>1 0.75 0 1</diffuse></material>
        </visual>
        <visual name="goal_green">
          <pose>2 5.2 0.0035 0 0 0</pose>
          <geometry><box><size>0.35 0.35 0.001</size></box></geometry>
          <material><ambient>0.02 0.85 0.08 1</ambient><diffuse>0.02 0.85 0.08 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- Physical barriers are collision objects seen by the ultrasonic sensor. -->
    <model name="blocked_j1_straight">
      <static>true</static>
      <pose>0.42 0 0.18 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.12 0.55 0.36</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.55 0.36</size></box></geometry>
          <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="blocked_j2_north">
      <static>true</static>
      <pose>-2 4.95 0.18 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.55 0.12 0.36</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.55 0.12 0.36</size></box></geometry>
          <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
    <model name="blocked_j3_east">
      <static>true</static>
      <pose>4.42 3 0.18 0 0 0</pose>
      <link name="wall">
        <collision name="collision"><geometry><box><size>0.12 0.55 0.36</size></box></geometry></collision>
        <visual name="visual"><geometry><box><size>0.12 0.55 0.36</size></box></geometry>
          <material><ambient>0.7 0.1 0.1 1</ambient><diffuse>0.7 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>
  </world>
</sdf>
