<?xml version="1.0" ?>
<sdf version="1.7">
  <model name="test_track">
    <static>true</static>

    <!-- White floor, raised 1cm above the main ground plane -->
    <link name="platform_link">
      <pose>0 0 0.005 0 0 0</pose>
      <collision name="collision">
        <geometry>
          <box><size>1.0 1.0 0.01</size></box>
        </geometry>
      </collision>
      <visual name="visual">
        <geometry>
          <box><size>1.0 1.0 0.01</size></box>
        </geometry>
        <material>
          <ambient>0.9 0.9 0.9 1</ambient>
          <diffuse>0.9 0.9 0.9 1</diffuse>
        </material>
      </visual>
    </link>

    <!-- Black square line, 0.6 x 0.6 m centerline, 0.03 m wide -->
    <link name="track_link">
      <visual name="top">
        <pose>0 0.3 0.011 0 0 0</pose>
        <geometry>
          <box><size>0.63 0.03 0.002</size></box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>
      <visual name="bottom">
        <pose>0 -0.3 0.011 0 0 0</pose>
        <geometry>
          <box><size>0.63 0.03 0.002</size></box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>
      <visual name="left">
        <pose>-0.3 0 0.011 0 0 0</pose>
        <geometry>
          <box><size>0.03 0.63 0.002</size></box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>
      <visual name="right">
        <pose>0.3 0 0.011 0 0 0</pose>
        <geometry>
          <box><size>0.03 0.63 0.002</size></box>
        </geometry>
        <material>
          <ambient>0 0 0 1</ambient>
          <diffuse>0 0 0 1</diffuse>
        </material>
      </visual>
    </link>

  </model>
</sdf>
